rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // TEMPORARY — no Auth session backs this uid yet (stub DataStore UUID, see CLAUDE.md
    // "Current phase"). Rules can't check per-owner request.auth.uid until real Firebase
    // Auth lands, so they stay intentionally permissive below. The one thing that IS
    // enforceable and meaningful without auth: a field-shape allowlist that blocks any
    // live-location-shaped field on journeys/outings, and a hard block on client writes
    // to notifications (only the Worker's service account, which bypasses rules, writes those).

    function hasNoLocationFields(data) {
      return !data.keys().hasAny(['lat', 'lng', 'latitude', 'longitude', 'location', 'coordinates']);
    }

    match /users/{uid} {
      allow read: if true; // TEMPORARY — no Auth session backs this uid yet
      allow write: if true; // TEMPORARY — no Auth session backs this uid yet (homeLocation lat/lng is allowed here only)

      match /trustedContacts/{contactUid} {
        allow read, write: if true; // TEMPORARY — no Auth session backs this uid yet
      }
    }

    match /outings/{outingId} {
      allow read: if true; // TEMPORARY — no Auth session backs this uid yet
      allow create, update: if hasNoLocationFields(request.resource.data);
      allow delete: if false;
    }

    match /journeys/{journeyId} {
      allow read: if true; // TEMPORARY — no Auth session backs this uid yet
      allow create, update: if hasNoLocationFields(request.resource.data);
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if true; // TEMPORARY — no Auth session backs this uid yet
      allow write: if false; // only the Worker's service account bypasses rules
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
